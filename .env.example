# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Service-role key — server-only. Used by `npm run admin:bootstrap` to
# create the master admin auth.users entry. NEVER ship this to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==========================================
# SUGGEST KEY — DEVELOPMENT AUTH CONTROLS
# ==========================================

# Master authentication switch
AUTH_ENABLED=true

# Development-only authentication bypass
DEV_AUTH_BYPASS=false

# Require authenticated session for protected routes
AUTH_ROUTE_GUARD=true

# Password authentication
PASSWORD_AUTH_ENABLED=true

# Magic-link authentication
MAGIC_LINK_ENABLED=true

# Email verification requirement
EMAIL_VERIFICATION_REQUIRED=false

# Password reset
PASSWORD_RESET_ENABLED=true

# Login/request rate limiting
AUTH_RATE_LIMIT_ENABLED=true

# Global application rate limiting
RATE_LIMIT_ENABLED=true

# Login cooldown
LOGIN_COOLDOWN_ENABLED=true

# Failed-login protection
LOGIN_ATTEMPT_LIMIT_ENABLED=true

# Role authorization
ROLE_GUARD_ENABLED=true

# Development default role ('seeker' | 'mentor' | 'admin')
DEV_AUTH_ROLE=seeker

