# =============================================================================
# Advisor Marketplace — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env or real secrets to version control.
# =============================================================================

# --- Supabase (Public / Frontend) ---
# These are intentionally exposed in the browser.
# Obtain from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (Server-side / Edge Functions) ---
# DO NOT expose these to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DATABASE_URL=

# --- OAuth Providers ---
# Configure these in the Supabase Dashboard → Authentication → Providers.
# Google OAuth client ID and secret are entered in the Supabase dashboard.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- CAPTCHA (Production) ---
# Enable in Supabase Dashboard → Authentication → CAPTCHA.
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# --- Application Metadata ---
# Used for SEO, OAuth redirects, and email templates.
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Advisor Marketplace

# --- External Services (if applicable) ---
# OPENAI_API_KEY=  # Only for Supabase Studio AI (local dev)
